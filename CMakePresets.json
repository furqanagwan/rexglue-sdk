{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_FLAGS": "-march=x86-64-v2",
        "CMAKE_CXX_FLAGS": "-march=x86-64-v2",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
        "CMAKE_CROSS_CONFIGS": "all",
        "CMAKE_DEFAULT_BUILD_TYPE": "Debug",
        "CMAKE_DEFAULT_CONFIGS": "all",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
        "REXGLUE_USE_GDK": "ON",
        "REXGLUE_GDK_EDITION": "260404",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-arm64-base",
      "hidden": true,
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-march=armv8-a",
        "CMAKE_CXX_FLAGS": "-march=armv8-a"
      }
    },
    {
      "name": "win-amd64",
      "displayName": "Windows AMD64 (GDK compatibility alias)",
      "description": "Compatibility spelling for win-amd64-gdk; GDK-free builds are retired",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/out/build/win-amd64-gdk",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/win-amd64-gdk"
      }
    },
    {
      "name": "win-amd64-gdk",
      "displayName": "Windows AMD64 (April 2026 GDK)",
      "description": "Windows x64 build against the required April 2026 PC GDK (260404); see docs/gdk-toolchain.md",
      "inherits": "windows-base",
      "cacheVariables": {
        "REXGLUE_USE_GDK": "ON",
        "REXGLUE_GDK_EDITION": "260404"
      }
    },
    {
      "name": "win-amd64-gdk-dxil",
      "displayName": "Windows AMD64 (April 2026 GDK) + DXIL toolchain",
      "description": "The win-amd64-gdk build plus the opt-in DXIL shader toolchain (Mesa spirv_to_dxil, D3D12 Agility SDK 1.618.5, DXC 1.8.2502.8); see docs/shader-dxil.md",
      "inherits": "win-amd64-gdk",
      "cacheVariables": {
        "REXGLUE_SHADER_DXIL": "ON"
      }
    },
    {
      "name": "win-arm64",
      "displayName": "Windows ARM64",
      "description": "Unsupported research preset; GDK ARM64 toolchain and title gates remain blocked under RG-GDK-030/031",
      "inherits": "windows-arm64-base"
    }
  ],
  "buildPresets": [
    {
      "name": "win-amd64-debug",
      "configurePreset": "win-amd64",
      "configuration": "Debug"
    },
    {
      "name": "win-amd64-release",
      "configurePreset": "win-amd64",
      "configuration": "Release"
    },
    {
      "name": "win-amd64-relwithdebinfo",
      "configurePreset": "win-amd64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "win-amd64-gdk-debug",
      "configurePreset": "win-amd64-gdk",
      "configuration": "Debug"
    },
    {
      "name": "win-amd64-gdk-release",
      "configurePreset": "win-amd64-gdk",
      "configuration": "Release"
    },
    {
      "name": "win-amd64-gdk-dxil-debug",
      "configurePreset": "win-amd64-gdk-dxil",
      "configuration": "Debug"
    },
    {
      "name": "win-amd64-gdk-dxil-release",
      "configurePreset": "win-amd64-gdk-dxil",
      "configuration": "Release"
    },
    {
      "name": "win-arm64-debug",
      "configurePreset": "win-arm64",
      "configuration": "Debug"
    },
    {
      "name": "win-arm64-release",
      "configurePreset": "win-arm64",
      "configuration": "Release"
    },
    {
      "name": "win-arm64-relwithdebinfo",
      "configurePreset": "win-arm64",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "win-amd64-debug",
      "configurePreset": "win-amd64",
      "configuration": "Debug"
    },
    {
      "name": "win-amd64-release",
      "configurePreset": "win-amd64",
      "configuration": "Release"
    },
    {
      "name": "win-amd64-relwithdebinfo",
      "configurePreset": "win-amd64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "win-amd64-gdk-debug",
      "configurePreset": "win-amd64-gdk",
      "configuration": "Debug"
    },
    {
      "name": "win-amd64-gdk-release",
      "configurePreset": "win-amd64-gdk",
      "configuration": "Release"
    },
    {
      "name": "win-amd64-gdk-dxil-debug",
      "configurePreset": "win-amd64-gdk-dxil",
      "configuration": "Debug"
    },
    {
      "name": "win-amd64-gdk-dxil-release",
      "configurePreset": "win-amd64-gdk-dxil",
      "configuration": "Release"
    },
    {
      "name": "win-arm64-debug",
      "configurePreset": "win-arm64",
      "configuration": "Debug"
    },
    {
      "name": "win-arm64-release",
      "configurePreset": "win-arm64",
      "configuration": "Release"
    },
    {
      "name": "win-arm64-relwithdebinfo",
      "configurePreset": "win-arm64",
      "configuration": "RelWithDebInfo"
    }
  ]
}
