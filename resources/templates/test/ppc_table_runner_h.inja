// Generated by rexglue recompile-tests
// DO NOT EDIT - this file is auto-generated
//
// Table-driven PPC test runner: each case is a run of operations over the
// context and guest memory, so a corpus of 170,000 cases compiles as data and
// runs from one loop per file instead of one Catch2 test per case.
#pragma once

#include <catch2/catch_test_macros.hpp>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <stdexcept>
#include <string>
#include "ppc_config.h"
#include <rex/ppc.h>
#include <rex/system/xmemory.h>
#include "ppc_test_decls.h"

namespace ppc_table {

enum Kind : uint8_t {
  kSetU64,     // u64 at context offset = a
  kSetVec,     // u32[3], u32[2] = a hi, lo; u32[1], u32[0] = b hi, lo
  kSetCr,      // cr0..cr7 from a
  kSetXer,     // SO, OV, CA from bits 31, 30, 29 of a
  kZeroMem,    // b bytes at guest address zeroed
  kSetMem,     // b bytes at guest address from the byte pool at a
  kCheckU64,   // u64 at context offset == a
  kCheckF64,   // f64 at context offset == bit_cast<double>(a), compared as doubles
  kCheckVec,
  kCheckCr,
  kCheckXer,
  kCheckMem,
};

struct Op {
  Kind kind;
  const char* reg;  // register name, for messages
  uint32_t where;   // context offset or guest address
  uint64_t a, b;
};

struct Case {
  const char* label;
  PPCFunc* fn;
  uint32_t first_op, op_count;
  const char* known_failure;  // cause, or nullptr when the case should pass
};

// One instance for every chunk: each reserves the guest address space.
inline rex::memory::Memory& GetMemory() {
  static rex::memory::Memory memory;
  static bool initialized = false;
  if (!initialized) {
    if (!memory.Initialize()) {
      throw std::runtime_error("Failed to initialize memory");
    }
    if (auto* heap = memory.LookupHeap(0x10000)) {
      heap->AllocFixed(0x10000, 0x10000000, 0x1000,
                       rex::memory::kMemoryAllocationReserve |
                           rex::memory::kMemoryAllocationCommit,
                       rex::memory::kMemoryProtectRead | rex::memory::kMemoryProtectWrite);
    }
    initialized = true;
  }
  return memory;
}

inline uint32_t CrRaw(const PPCContext& ctx) {
  return (ctx.cr0.raw() << 28) | (ctx.cr1.raw() << 24) | (ctx.cr2.raw() << 20) |
         (ctx.cr3.raw() << 16) | (ctx.cr4.raw() << 12) | (ctx.cr5.raw() << 8) |
         (ctx.cr6.raw() << 4) | ctx.cr7.raw();
}

inline uint32_t XerRaw(const PPCContext& ctx) {
  return (uint32_t(ctx.xer.so) << 31) | (uint32_t(ctx.xer.ov) << 30) |
         (uint32_t(ctx.xer.ca) << 29);
}

inline std::string Hex(uint64_t v) {
  char buf[24];
  std::snprintf(buf, sizeof(buf), "0x%llX", static_cast<unsigned long long>(v));
  return buf;
}

// Runs one case; returns the first mismatch, or an empty string.
inline std::string RunCase(const Case& c, const Op* ops, const uint8_t* pool) {
  uint8_t* memory = GetMemory().virtual_membase();
  PPCContext ctx{};
  PPCInterruptTestScope interrupt_scope;
  // A case starts from the reset FPSCR (round to nearest, no flush), not from
  // whatever rounding mode or flush the previous case left on the host.
  ctx.fpscr.setcsr(0x1F80);
  ctx.fpscr.loadFromHost();
  auto* raw = reinterpret_cast<uint8_t*>(&ctx);
  const Op* begin = ops + c.first_op;
  const Op* end = begin + c.op_count;
  auto vec = [&](uint32_t off) { return reinterpret_cast<uint32_t*>(raw + off); };
  // The test data window starts clear, as Edge's runner leaves it, so bytes a
  // case doesn't set aren't left over from the case before.
  std::memset(memory + 0x10001000, 0, 0xEFFF);
  for (const Op* op = begin; op != end && op->kind < kCheckU64; ++op) {
    switch (op->kind) {
      case kSetU64:
        std::memcpy(raw + op->where, &op->a, 8);
        break;
      case kSetVec: {
        uint32_t* v = vec(op->where);
        v[3] = uint32_t(op->a >> 32), v[2] = uint32_t(op->a);
        v[1] = uint32_t(op->b >> 32), v[0] = uint32_t(op->b);
        break;
      }
      case kSetCr:
        ctx.cr0.set_raw((op->a >> 28) & 0xF), ctx.cr1.set_raw((op->a >> 24) & 0xF);
        ctx.cr2.set_raw((op->a >> 20) & 0xF), ctx.cr3.set_raw((op->a >> 16) & 0xF);
        ctx.cr4.set_raw((op->a >> 12) & 0xF), ctx.cr5.set_raw((op->a >> 8) & 0xF);
        ctx.cr6.set_raw((op->a >> 4) & 0xF), ctx.cr7.set_raw(op->a & 0xF);
        break;
      case kSetXer:
        ctx.xer.so = (op->a >> 31) & 1, ctx.xer.ov = (op->a >> 30) & 1;
        ctx.xer.ca = (op->a >> 29) & 1;
        break;
      case kZeroMem:
        std::memset(memory + op->where, 0, op->b);
        break;
      case kSetMem:
        std::memcpy(memory + op->where, pool + op->a, op->b);
        break;
      default:
        break;
    }
  }

  c.fn(ctx, memory);

  for (const Op* op = begin; op != end; ++op) {
    uint64_t got = 0, want = op->a;
    switch (op->kind) {
      case kCheckU64:
        std::memcpy(&got, raw + op->where, 8);
        break;
      case kCheckF64: {
        double g, w;
        std::memcpy(&g, raw + op->where, 8), std::memcpy(&w, &op->a, 8);
        std::memcpy(&got, &g, 8);
        if (g == w) {
          continue;
        }
        break;
      }
      case kCheckVec: {
        const uint32_t* v = vec(op->where);
        const uint64_t hi = (uint64_t(v[3]) << 32) | v[2], lo = (uint64_t(v[1]) << 32) | v[0];
        if (hi == op->a && lo == op->b) {
          continue;
        }
        return std::string(op->reg) + " = " + Hex(hi) + "_" + Hex(lo) + ", expected " +
               Hex(op->a) + "_" + Hex(op->b);
      }
      case kCheckCr:
        got = CrRaw(ctx);
        break;
      case kCheckXer:
        got = XerRaw(ctx);
        break;
      case kCheckMem:
        for (uint64_t i = 0; i < op->b; ++i) {
          const uint8_t g = memory[op->where + i], w = pool[op->a + i];
          if (g != w) {
            return "memory " + Hex(op->where + i) + " = " + Hex(g) + ", expected " + Hex(w);
          }
        }
        continue;
      default:
        continue;
    }
    if (got != want) {
      return std::string(op->reg) + " = " + Hex(got) + ", expected " + Hex(want);
    }
  }
  return {};
}

// Runs a file's cases. Unexpected failures, and known failures that now pass,
// each fail the test with one line. With PPC_CORPUS_FAILURES set to a path,
// every failing "stem/label" is appended to it (for known_failures.txt).
inline void RunCases(const char* stem, const Case* cases, size_t count, const Op* ops,
                     const uint8_t* pool) {
  FILE* failures_out = nullptr;
  if (const char* path = std::getenv("PPC_CORPUS_FAILURES")) {
    failures_out = std::fopen(path, "a");
  }
  size_t unexpected = 0, fixed = 0, known = 0;
  for (size_t i = 0; i < count; ++i) {
    const Case& c = cases[i];
    std::string mismatch;
    try {
      mismatch = RunCase(c, ops, pool);
    } catch (const std::exception& e) {
      mismatch = std::string("exception: ") + e.what();
    }
    if (!mismatch.empty() && failures_out) {
      std::fprintf(failures_out, "%s/%s %s\n", stem, c.label, mismatch.c_str());
    }
    if (c.known_failure) {
      if (mismatch.empty()) {
        ++fixed;
        FAIL_CHECK(stem << "/" << c.label << " now passes; remove it from known_failures.txt");
      } else {
        ++known;
      }
    } else if (!mismatch.empty()) {
      ++unexpected;
      FAIL_CHECK(stem << "/" << c.label << ": " << mismatch);
    }
  }
  if (failures_out) {
    std::fclose(failures_out);
  }
  INFO(stem << ": " << count << " cases, " << known << " known failures");
  CHECK(unexpected == 0);
  CHECK(fixed == 0);
}

}  // namespace ppc_table
