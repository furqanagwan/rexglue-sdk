# Auto-generated by rexglue - DO NOT EDIT

# SDK version
# Set REXSDK_VERSION to pin a specific SDK version.
# Otherwise, the version of the SDK that generated this file is used.
set(REXSDK_VERSION "" CACHE STRING "Override SDK version (leave empty for default)")

# Find SDK
set(REXSDK_DIR "" CACHE PATH "Path to rexglue-sdk source tree")
if(REXSDK_DIR)
    add_subdirectory("{{ cmake_var("REXSDK_DIR") }}" rexglue-sdk)
    message(STATUS "Using ReXGlue SDK from source tree: {{ cmake_var("REXSDK_DIR") }}")
else()
    if(REXSDK_VERSION)
        find_package(rexglue {{ cmake_var("REXSDK_VERSION") }} EXACT QUIET CONFIG)
    else()
        find_package(rexglue {{ sdk_version }} QUIET CONFIG)
    endif()
    if(NOT rexglue_FOUND)
        message(FATAL_ERROR
            "ReXGlue SDK not found. Either:\n"
            "  - Set REXSDK_DIR to the rexglue-sdk source tree (e.g. thirdparty/rexglue-sdk)\n"
            "  - Install the SDK package and ensure it is on CMAKE_PREFIX_PATH")
    endif()
    message(STATUS "Found ReXGlue SDK ${REXGLUE_VERSION_STRING} at ${rexglue_DIR}")
endif()

# Host target name used by the codegen-emitted dll_targets.cmake to colocate
# guest DLLs with the host EXE. Defaults to PROJECT_NAME (which the
# manifest-first init flow sets equal to the host target name).
if(NOT DEFINED REXGLUE_HOST_TARGET)
    set(REXGLUE_HOST_TARGET {{ cmake_var("PROJECT_NAME") }})
endif()

set(REXGLUE_RECOMP_DEBUG_INFO "line-tables-only" CACHE STRING
    "Debug info level for generated code: line-tables-only, full, or none")

# Guest SEH scopes emit __try/__except, which traps hardware faults only under
# asynchronous EH. clang++ spells that flag the GNU way.
set(REXGLUE_RECOMP_OPTIONS "")
if(WIN32)
    if(MSVC)
        list(APPEND REXGLUE_RECOMP_OPTIONS /EHa)
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        list(APPEND REXGLUE_RECOMP_OPTIONS -fasync-exceptions)
    endif()
endif()
if(REXGLUE_RECOMP_DEBUG_INFO STREQUAL "none")
    list(APPEND REXGLUE_RECOMP_OPTIONS
        $<$<CXX_COMPILER_ID:Clang,AppleClang,GNU>:-g0>)
elseif(REXGLUE_RECOMP_DEBUG_INFO STREQUAL "line-tables-only")
    list(APPEND REXGLUE_RECOMP_OPTIONS
        $<$<CXX_COMPILER_ID:Clang,AppleClang>:-gline-tables-only>)
endif()

# Include entrypoint generated code if codegen has been run.
if(EXISTS "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ entrypoint_out_dir }}/sources.cmake")
    include({{ entrypoint_out_dir }}/sources.cmake)
    set(REXGLUE_ENTRYPOINT_GENERATED_SOURCES {{ cmake_var("GENERATED_SOURCES") }})
    set(REXGLUE_ENTRYPOINT_INCLUDE_DIR "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ entrypoint_out_dir }}")

    # Carried on the sources so they hold for whichever target compiles them.
    set_source_files_properties({{ cmake_var("REXGLUE_ENTRYPOINT_GENERATED_SOURCES") }}
        PROPERTIES COMPILE_OPTIONS "{{ cmake_var("REXGLUE_RECOMP_OPTIONS") }}")
endif()
# Each version's sources.cmake sets the add-on list its executable embeds.
set(REXGLUE_ENTRYPOINT_DLC_IDS "{{ cmake_var("REXGLUE_TITLE_DLC_IDS") }}")
{% for tu in title_updates %}
# Title update {{ tu.version }} ([[title_update]] in the manifest): the executable
# again, patched by that update, built as <target>_tu{{ tu.version }}.
if(EXISTS "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ tu.out_dir }}/sources.cmake")
    include({{ tu.out_dir }}/sources.cmake)
    set({{ tu.sources_var }} {{ cmake_var("GENERATED_SOURCES") }})
    set({{ tu.dlc_var }} "{{ cmake_var("REXGLUE_TITLE_DLC_IDS") }}")
    set_source_files_properties({{ cmake_var(tu.sources_var) }}
        PROPERTIES COMPILE_OPTIONS "{{ cmake_var("REXGLUE_RECOMP_OPTIONS") }}")
endif()
{% endfor %}
set(REXGLUE_TITLE_DLC_IDS "{{ cmake_var("REXGLUE_ENTRYPOINT_DLC_IDS") }}")

# The options go on the target as well: CMake compiles the header from its own
# cmake_pch.hxx.cxx, which carries none of the source properties above, and
# clang rejects a PCH whose EH mode disagrees with the TU including it.
function(rexglue_apply_recomp_settings target_name pch_header)
    target_precompile_headers({{ cmake_var("target_name") }} PRIVATE "{{ cmake_var("pch_header") }}")
    target_compile_options({{ cmake_var("target_name") }} PRIVATE {{ cmake_var("REXGLUE_RECOMP_OPTIONS") }})
endfunction()

# Links one executable to its generated code: an object library built from
# `sources`, with `include_dir` (that version's generated headers) on both.
function(_rexglue_link_recomp target_name sources include_dir)
    if(sources)
        add_library({{ cmake_var("target_name") }}_recomp OBJECT {{ cmake_var("sources") }})
        target_include_directories({{ cmake_var("target_name") }}_recomp PRIVATE
            {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}
            {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/src
            {{ cmake_var("include_dir") }}
        )
        target_link_libraries({{ cmake_var("target_name") }}_recomp PRIVATE rex::runtime)
        rexglue_apply_target_settings({{ cmake_var("target_name") }}_recomp)
        rexglue_apply_recomp_settings({{ cmake_var("target_name") }}_recomp
            "{{ cmake_var("include_dir") }}/{{ names.original }}_pch.h")
        add_dependencies({{ cmake_var("target_name") }}_recomp {{ names.original }}_codegen)
        target_link_libraries({{ cmake_var("target_name") }} PRIVATE
            {{ cmake_var("target_name") }}_recomp)
    endif()
    # Also on the host, so a tree that has never run codegen still generates it.
    add_dependencies({{ cmake_var("target_name") }} {{ names.original }}_codegen)
    target_include_directories({{ cmake_var("target_name") }} PRIVATE
        {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}
        {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/src
        {{ cmake_var("include_dir") }}
    )
    target_link_libraries({{ cmake_var("target_name") }} PRIVATE rex::runtime)
    if(EXISTS "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/metadata/icons")
        rexglue_embed_metadata({{ cmake_var("target_name") }}
            DIRECTORY "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/metadata/icons"
            PREFIX "icons")
    endif()
endfunction()

# Configure a rexglue target with SDK libraries and platform settings.
# Call after add_executable() in your CMakeLists.txt.
# Usage: rexglue_setup_target(<target> [GPU_PLUGINS xenos])
# Each [[title_update]] in the manifest also gets <target>_tu<version>, built
# from the same host sources against that version's generated code.
macro(rexglue_setup_target target_name)
    get_target_property(_rexglue_host_sources {{ cmake_var("target_name") }} SOURCES)
    get_target_property(_rexglue_host_win32 {{ cmake_var("target_name") }} WIN32_EXECUTABLE)
    _rexglue_link_recomp({{ cmake_var("target_name") }}
        "{{ cmake_var("REXGLUE_ENTRYPOINT_GENERATED_SOURCES") }}"
        "{{ cmake_var("REXGLUE_ENTRYPOINT_INCLUDE_DIR") }}")
    if(EXISTS "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/gdk/MicrosoftGame.config")
        rexglue_add_game_config({{ cmake_var("target_name") }}
            DIRECTORY "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/gdk")
    endif()
    rexglue_configure_target({{ cmake_var("target_name") }} {{ cmake_var("ARGN") }})
{% for tu in title_updates %}
    if({{ tu.sources_var }})
        add_executable({{ cmake_var("target_name") }}_tu{{ tu.version }} {{ cmake_var("_rexglue_host_sources") }})
        set_target_properties({{ cmake_var("target_name") }}_tu{{ tu.version }} PROPERTIES
            WIN32_EXECUTABLE "{{ cmake_var("_rexglue_host_win32") }}")
        _rexglue_link_recomp({{ cmake_var("target_name") }}_tu{{ tu.version }}
            "{{ cmake_var(tu.sources_var) }}"
            "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ tu.out_dir }}")
        # This version's own add-on list for its catalogue, then the original's again.
        set(REXGLUE_TITLE_DLC_IDS "{{ cmake_var(tu.dlc_var) }}")
        rexglue_configure_target({{ cmake_var("target_name") }}_tu{{ tu.version }} {{ cmake_var("ARGN") }})
        set(REXGLUE_TITLE_DLC_IDS "{{ cmake_var("REXGLUE_ENTRYPOINT_DLC_IDS") }}")
    endif()
{% endfor %}
endmacro()

# Codegen runs as part of the build, re-running only when an input in codegen.d
# changes. Build it alone with 'cmake --build . --target {{ names.original }}_codegen'.
# Listing the sources as outputs orders any target that compiles them after
# codegen, including one a project assembles itself rather than taking the
# library rexglue_setup_target() builds. The stamp comes first: the DEPFILE
# names it.
add_custom_command(
    OUTPUT "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ entrypoint_out_dir }}/codegen.build.stamp"
           {{ cmake_var("REXGLUE_ENTRYPOINT_GENERATED_SOURCES") }}
{% for tu in title_updates %}           {{ cmake_var(tu.sources_var) }}
{% endfor %}    COMMAND $<TARGET_FILE:rex::rexglue> codegen {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ names.original }}_manifest.toml
    DEPFILE "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ entrypoint_out_dir }}/codegen.d"
    WORKING_DIRECTORY {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}
    COMMENT "Generating recompiled code for {{ names.original }}"
    VERBATIM
)
add_custom_target({{ names.original }}_codegen
    DEPENDS "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ entrypoint_out_dir }}/codegen.build.stamp")

# Include DLL module shared library targets if codegen has generated them
if(EXISTS "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ entrypoint_out_dir }}/dll_targets.cmake")
    include({{ entrypoint_out_dir }}/dll_targets.cmake)
endif()
