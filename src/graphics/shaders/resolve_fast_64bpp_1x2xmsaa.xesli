#include "endian.xesli"
#define XE_RESOLVE_COPY_EDRAM_IS_UINT_VECTOR_BUFFER
#include "resolve.xesli"

array_buffer_wo_declare_xe(uint4_xe, xe_resolve_dest, set=1, binding=0, u0,
                           space0)
#define LOCAL_SIZE_X_XE 8
#define LOCAL_SIZE_Y_XE 8
#define LOCAL_SIZE_Z_XE 1
entry_bindings_begin_compute_xe
  XE_RESOLVE_PUSH_CONST_BINDING
  entry_binding_next_xe
  array_buffer_wo_binding_xe(uint4_xe, xe_resolve_dest, buffer(1))
  entry_binding_next_xe
  XE_RESOLVE_COPY_EDRAM_BINDING
entry_bindings_end_inputs_begin_compute_xe
  entry_in_global_thread_id_xe
entry_inputs_end_code_begin_compute_xe
{
  // 1 thread = 4 host pixels.
  XeResolveInfo resolve_info = XeResolveGetInfo(pass_push_consts_xe);
  uint2_xe pixel_index = in_global_thread_id_xe.xy << uint2_xe(2u, 0u);
  // Group height can't cross resolve granularity, Y overflow check not needed.
  dont_flatten_xe
  if (pixel_index.x >= resolve_info.width_div_8_scaled << 3u) {
    return;
  }
  uint4_xe pixels_01, pixels_23;
  dont_flatten_xe
  if (resolve_info.edram_msaa_samples == kXenosMsaaSamples_1X) {
    // With 1x MSAA the pixels are the canonical samples, thus the scanline is
    // contiguous and a single vectorized load suffices.
    uint source_address =
        XeResolveCopySourceFirstSampleAddressInts(resolve_info, pixel_index);
    pixels_01 = uint_vector_buffer_load4_xe(xe_resolve_edram, source_address);
    pixels_23 =
        uint_vector_buffer_load4_xe(xe_resolve_edram, source_address + 4u);
  } else {
    // There's no fixed stride between horizontally adjacent pixels of a
    // multisampled source, load each pixel from its respective address.
    pixels_01.xy = uint_vector_buffer_load2_xe(
        xe_resolve_edram,
        XeResolveCopySourceFirstSampleAddressInts(resolve_info, pixel_index));
    pixels_01.zw = uint_vector_buffer_load2_xe(
        xe_resolve_edram,
        XeResolveCopySourceFirstSampleAddressInts(
            resolve_info, pixel_index + uint2_xe(1u, 0u)));
    pixels_23.xy = uint_vector_buffer_load2_xe(
        xe_resolve_edram,
        XeResolveCopySourceFirstSampleAddressInts(
            resolve_info, pixel_index + uint2_xe(2u, 0u)));
    pixels_23.zw = uint_vector_buffer_load2_xe(
        xe_resolve_edram,
        XeResolveCopySourceFirstSampleAddressInts(
            resolve_info, pixel_index + uint2_xe(3u, 0u)));
  }
  dont_flatten_xe
  if (pixel_index.x == 0u &&
      resolve_info.half_pixel_offset_fill_source.x != 0u) {
    if (resolve_info.half_pixel_offset_fill_source.x >= 2u) {
      if (resolve_info.half_pixel_offset_fill_source.x >= 3u) {
        pixels_23.xy = pixels_23.zw;
      }
      pixels_01.zw = pixels_23.xy;
    }
    pixels_01.xy = pixels_01.zw;
  }
  XeResolveSwap4PixelsRedBlue64bpp(resolve_info, pixels_01, pixels_23);
  uint dest_address =
      XeResolveDestPixelAddress(resolve_info, pixel_index, 3u) >> 4u;
  array_buffer_store_xe(
      xe_resolve_dest, dest_address,
      XeEndianSwap64(pixels_01, resolve_info.dest_endian_128));
  dest_address += XeResolveDestRightConsecutiveBlocksOffset(
                      pixel_index.x, 3u, resolve_info.resolution_scale) >> 4u;
  array_buffer_store_xe(
      xe_resolve_dest, dest_address,
      XeEndianSwap64(pixels_23, resolve_info.dest_endian_128));
}
entry_code_end_compute_xe
