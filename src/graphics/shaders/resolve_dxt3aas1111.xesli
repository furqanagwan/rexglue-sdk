#include "endian.xesli"
#define XE_RESOLVE_COPY_EDRAM_IS_UINT_VECTOR_BUFFER
#define XE_RESOLVE_COPY_DXT3A_AS_1111
#include "resolve.xesli"

array_buffer_wo_declare_xe(uint4_xe, xe_resolve_dest, set=1, binding=0, u0,
                           space0)
#define LOCAL_SIZE_X_XE 32
#define LOCAL_SIZE_Y_XE 2
#define LOCAL_SIZE_Z_XE 1

uint XeResolve1111Component(uint pixel, uint component, uint func, uint ref,
                            uint mask) {
  uint shift = component << 3u;
  uint component_mask = (mask >> shift) & 0xFFu;
  uint value = (pixel >> shift) & component_mask;
  uint ref_value = (ref >> shift) & component_mask;
  uint relation = value < ref_value ? 4u : (value == ref_value ? 2u : 1u);
  return ((func >> (component << 2u)) & relation) != 0u ? 1u : 0u;
}

uint XeResolve1111Pixel(uint pixel, uint func, uint ref, uint mask) {
  return XeResolve1111Component(pixel, 0u, func, ref, mask) |
         (XeResolve1111Component(pixel, 1u, func, ref, mask) << 1u) |
         (XeResolve1111Component(pixel, 2u, func, ref, mask) << 2u) |
         (XeResolve1111Component(pixel, 3u, func, ref, mask) << 3u);
}

uint XeResolve1111FourPixels(uint4_xe pixels, uint func, uint ref, uint mask) {
  return XeResolve1111Pixel(pixels.x, func, ref, mask) |
         (XeResolve1111Pixel(pixels.y, func, ref, mask) << 4u) |
         (XeResolve1111Pixel(pixels.z, func, ref, mask) << 8u) |
         (XeResolve1111Pixel(pixels.w, func, ref, mask) << 12u);
}

uint2_xe XeResolve1111EightPixels(
    param_uint_vector_buffer_xe(xe_resolve_edram)
    param_next_after_uint_vector_buffer_xe
    const XeResolveInfo resolve_info, uint2_xe pixel_index, uint func,
    uint ref, uint mask) {
  uint4_xe pixels_0123, pixels_4567;
  dont_flatten_xe
  if (resolve_info.edram_msaa_samples == kXenosMsaaSamples_1X) {
    uint source_address =
        XeResolveCopySourceFirstSampleAddressInts(resolve_info, pixel_index);
    pixels_0123 =
        uint_vector_buffer_load4_xe(xe_resolve_edram, source_address);
    pixels_4567 =
        uint_vector_buffer_load4_xe(xe_resolve_edram, source_address + 4u);
  } else {
    pixels_0123.x = uint_vector_buffer_load1_xe(
        xe_resolve_edram,
        XeResolveCopySourceFirstSampleAddressInts(resolve_info, pixel_index));
    pixels_0123.y = uint_vector_buffer_load1_xe(
        xe_resolve_edram,
        XeResolveCopySourceFirstSampleAddressInts(
            resolve_info, pixel_index + uint2_xe(1u, 0u)));
    pixels_0123.z = uint_vector_buffer_load1_xe(
        xe_resolve_edram,
        XeResolveCopySourceFirstSampleAddressInts(
            resolve_info, pixel_index + uint2_xe(2u, 0u)));
    pixels_0123.w = uint_vector_buffer_load1_xe(
        xe_resolve_edram,
        XeResolveCopySourceFirstSampleAddressInts(
            resolve_info, pixel_index + uint2_xe(3u, 0u)));
    pixels_4567.x = uint_vector_buffer_load1_xe(
        xe_resolve_edram,
        XeResolveCopySourceFirstSampleAddressInts(
            resolve_info, pixel_index + uint2_xe(4u, 0u)));
    pixels_4567.y = uint_vector_buffer_load1_xe(
        xe_resolve_edram,
        XeResolveCopySourceFirstSampleAddressInts(
            resolve_info, pixel_index + uint2_xe(5u, 0u)));
    pixels_4567.z = uint_vector_buffer_load1_xe(
        xe_resolve_edram,
        XeResolveCopySourceFirstSampleAddressInts(
            resolve_info, pixel_index + uint2_xe(6u, 0u)));
    pixels_4567.w = uint_vector_buffer_load1_xe(
        xe_resolve_edram,
        XeResolveCopySourceFirstSampleAddressInts(
            resolve_info, pixel_index + uint2_xe(7u, 0u)));
  }
  return uint2_xe(XeResolve1111FourPixels(pixels_0123, func, ref, mask),
                  XeResolve1111FourPixels(pixels_4567, func, ref, mask));
}

entry_bindings_begin_compute_xe
  XE_RESOLVE_PUSH_CONST_BINDING
  entry_binding_next_xe
  array_buffer_wo_binding_xe(uint4_xe, xe_resolve_dest, buffer(1))
  entry_binding_next_xe
  XE_RESOLVE_COPY_EDRAM_BINDING
entry_bindings_end_inputs_begin_compute_xe
  entry_in_global_thread_id_xe
entry_inputs_end_code_begin_compute_xe
{
  XeResolveInfo resolve_info = XeResolveGetInfo(pass_push_consts_xe);
  dont_flatten_xe
  if (in_global_thread_id_xe.x >= resolve_info.width_div_8_scaled) {
    return;
  }
  uint func = push_const_xe(xe_resolve_copy_func);
  uint ref = push_const_xe(xe_resolve_copy_ref);
  uint mask = push_const_xe(xe_resolve_copy_mask);
  uint2_xe pixel_index = in_global_thread_id_xe.xy << uint2_xe(3u, 2u);
  uint2_xe row_0 = XeResolve1111EightPixels(
      pass_uint_vector_buffer_xe(xe_resolve_edram)
      pass_next_after_uint_vector_buffer_xe
      resolve_info, pixel_index, func, ref, mask);
  uint2_xe row_1 = XeResolve1111EightPixels(
      pass_uint_vector_buffer_xe(xe_resolve_edram)
      pass_next_after_uint_vector_buffer_xe
      resolve_info, pixel_index + uint2_xe(0u, 1u), func, ref, mask);
  uint2_xe row_2 = XeResolve1111EightPixels(
      pass_uint_vector_buffer_xe(xe_resolve_edram)
      pass_next_after_uint_vector_buffer_xe
      resolve_info, pixel_index + uint2_xe(0u, 2u), func, ref, mask);
  uint2_xe row_3 = XeResolve1111EightPixels(
      pass_uint_vector_buffer_xe(xe_resolve_edram)
      pass_next_after_uint_vector_buffer_xe
      resolve_info, pixel_index + uint2_xe(0u, 3u), func, ref, mask);
  uint4_xe blocks = uint4_xe(row_0.x | (row_1.x << 16u),
                             row_2.x | (row_3.x << 16u),
                             row_0.y | (row_1.y << 16u),
                             row_2.y | (row_3.y << 16u));
  uint2_xe block_index =
      uint2_xe(in_global_thread_id_xe.x << 1u, in_global_thread_id_xe.y) +
      (resolve_info.dest_xy_offset_scaled >> 2u);
  uint dest_address =
      uint(XeTextureTiledOffset2D(int2_xe(block_index),
                                  resolve_info.dest_row_pitch_aligned, 3u)) +
      resolve_info.dest_base;
  array_buffer_store_xe(xe_resolve_dest, dest_address >> 4u,
                        XeEndianSwap64(blocks, resolve_info.dest_endian_128));
}
entry_code_end_compute_xe
