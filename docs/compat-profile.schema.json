{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/furqanagwan/rexglue-sdk/docs/compat-profile.schema.json",
  "title": "ReXGlue title compatibility profile (ADR-009)",
  "description": "A title project's <title>_compat.toml, validated by rexglue at build time and embedded in the executable. Fix names must exist in the SDK fix catalog; unknown keys are errors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module"],
  "properties": {
    "schema_version": { "const": 1 },
    "module": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title_id", "xex_sha256"],
        "properties": {
          "title_id": {
            "description": "Xbox 360 title ID, eight hex digits",
            "type": "string",
            "pattern": "^[0-9A-F]{8}$"
          },
          "xex_sha256": {
            "description": "SHA-256 of the exact module the build was generated from; the profile applies only when the running module matches",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "version": {
            "description": "Informational version string",
            "type": "string"
          },
          "fixes": {
            "description": "Catalog fixes this module turns on",
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/fix_name" }
          },
          "disable": {
            "description": "Default-on catalog fixes this module turns off",
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/fix_name" }
          }
        }
      }
    },
    "fix": {
      "description": "Per-title evidence for each listed fix",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/fix_name" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence", "added"],
        "properties": {
          "evidence": {
            "description": "Baseline run, test or upstream reference showing this title needs the fix",
            "type": "string",
            "minLength": 1
          },
          "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  },
  "$defs": {
    "fix_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
  }
}
